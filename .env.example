# Hermes Agent Railway Template - Environment Variables
#
# Copy this file to .env for local testing or reference when deploying to Railway.
# All variables are optional unless marked as REQUIRED.

# =============================================================================
# WEB UI CONFIGURATION
# =============================================================================
PORT=8080
ADMIN_USERNAME=admin
# ADMIN_PASSWORD=changeme  # If not set, a random password is generated

# =============================================================================
# LLM PROVIDERS (At least one REQUIRED)
# =============================================================================

# OpenRouter - Recommended (200+ models, one API key)
HERMES_OPENROUTER_API_KEY=

# Anthropic - Claude models
HERMES_ANTHROPIC_API_KEY=

# OpenAI - GPT models
HERMES_OPENAI_API_KEY=

# Zhipu AI / z.ai - GLM models
HERMES_GLM_API_KEY=

# Moonshot / Kimi - Kimi coding models
HERMES_KIMI_API_KEY=

# MiniMax - MiniMax models
HERMES_MINIMAX_API_KEY=

# Nous Portal - Hermes-optimized models
HERMES_NOUS_PORTAL_KEY=

# Provider selection (optional - auto-detected if not set)
# HERMES_PROVIDER=openrouter

# =============================================================================
# AGENT CONFIGURATION
# =============================================================================

# Default model
HERMES_MODEL=anthropic/claude-opus-4.6

# Generation parameters
HERMES_MAX_TOKENS=8192
HERMES_TEMPERATURE=0.7
HERMES_MAX_ITERATIONS=50

# =============================================================================
# MESSAGING PLATFORMS (At least one REQUIRED)
# =============================================================================

# Telegram
HERMES_TELEGRAM_TOKEN=
HERMES_TELEGRAM_ALLOWED_USERS=
# HERMES_TELEGRAM_HOME_CHANNEL=
# HERMES_TELEGRAM_ALLOW_ALL_USERS=false

# Discord
HERMES_DISCORD_TOKEN=
HERMES_DISCORD_ALLOWED_USERS=
# HERMES_DISCORD_HOME_CHANNEL=
# HERMES_DISCORD_ALLOW_ALL_USERS=false

# Slack
HERMES_SLACK_BOT_TOKEN=
HERMES_SLACK_APP_TOKEN=
HERMES_SLACK_ALLOWED_USERS=
# HERMES_SLACK_HOME_CHANNEL=
# HERMES_SLACK_ALLOW_ALL_USERS=false

# WhatsApp
HERMES_WHATSAPP_ENABLED=false
HERMES_WHATSAPP_ALLOWED_USERS=

# =============================================================================
# SECURITY
# =============================================================================

# Allow all users (NOT recommended - use allowlists instead)
# HERMES_GATEWAY_ALLOW_ALL=false

# =============================================================================
# TOOL API KEYS (Optional)
# =============================================================================

# Browser automation (Browserbase)
HERMES_BROWSERBASE_API_KEY=
HERMES_BROWSERBASE_PROJECT_ID=

# Web search
HERMES_PARALLEL_API_KEY=
HERMES_FIRECRAWL_API_KEY=

# Image generation
HERMES_FAL_KEY=

# Voice / TTS
HERMES_VOICE_OPENAI_KEY=
HERMES_ELEVENLABS_KEY=

# =============================================================================
# TERMINAL BACKEND
# =============================================================================

# Backend type: docker, local, ssh, modal
HERMES_TERMINAL_BACKEND=docker
HERMES_TERMINAL_TIMEOUT=180
HERMES_TERMINAL_CWD=/data/workspace

# SSH backend settings (if using ssh)
# HERMES_TERMINAL_SSH_HOST=
# HERMES_TERMINAL_SSH_USER=
# HERMES_TERMINAL_SSH_PORT=22
# HERMES_TERMINAL_SSH_KEY=

# =============================================================================
# ADVANCED SETTINGS
# =============================================================================

# Context compression
# HERMES_CONTEXT_COMPRESSION_ENABLED=true
# HERMES_CONTEXT_COMPRESSION_THRESHOLD=0.85

# Debug logging
# HERMES_WEB_TOOLS_DEBUG=false
# HERMES_VISION_TOOLS_DEBUG=false
# HERMES_IMAGE_TOOLS_DEBUG=false
