# Hermes Agent Railway Template - environment variables
# Copy the ones you need into Railway's service variables (never commit real values).
# Hermes reads these directly from the process environment or writes them
# to /opt/data/.env (manageable later from the dashboard's API Keys page).
# Full reference: https://hermes-agent.nousresearch.com/docs/reference/environment-variables

# --- Web dashboard (auth is mandatory on public binds) ---
# HERMES_DASHBOARD_BASIC_AUTH_USERNAME=admin
# HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=change-me-strong
# HERMES_DASHBOARD_BASIC_AUTH_SECRET=YOUR_RANDOM_SECRET_HERE   # keeps sessions stable across restarts; generate with 32+ random bytes

# --- LLM provider (at least one) ---
# OPENROUTER_API_KEY=sk-or-...
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GLM_API_KEY=...
# KIMI_API_KEY=...
# MINIMAX_API_KEY=...
# DEEPSEEK_API_KEY=...

# --- Messaging platform (at least one to chat with the agent) ---
# TELEGRAM_BOT_TOKEN=123456:ABC...
# TELEGRAM_ALLOWED_USERS=123456789
# TELEGRAM_HOME_CHANNEL=...
# DISCORD_BOT_TOKEN=...
# DISCORD_ALLOWED_USERS=...
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_APP_TOKEN=xapp-...
# SLACK_ALLOWED_USERS=...
# WHATSAPP_ENABLED=true

# --- Optional tool keys ---
# BROWSERBASE_API_KEY=
# BROWSERBASE_PROJECT_ID=
# PARALLEL_API_KEY=
# FIRECRAWL_API_KEY=
# FAL_KEY=
# ELEVENLABS_API_KEY=

# --- Optional gateway API server (OpenAI-compatible, port 8642) ---
# API_SERVER_ENABLED=true
# API_SERVER_HOST=0.0.0.0
# API_SERVER_KEY=openssl-rand-hex-32
